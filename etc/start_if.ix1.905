#!/bin/sh
#
# /etc/start_if.ix1.905
#
# Post Init Script to finish setting up the interface using ifconfig
#
# Don't forget to make this exscutable!
# chmod +x /etc/start_if.ix1.905
#

# Setup the MTU first
ifconfig $1 mtu 1500

# Now set the ip and bring up the interface
ifconfig $1 inet 192.0.0.9/24 up
